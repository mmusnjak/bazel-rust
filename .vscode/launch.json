{
    // Debug configurations for the CodeLLDB extension (vadimcn.vscode-lldb).
    //
    // Each configuration first runs a task that builds with `-c dbg`. That step
    // is necessary. The `bazel-bin` symlink points to the output of the last
    // build, so a build in another compilation mode moves the symlink away from
    // the debug binary.
    //
    // `cwd` and `sourceMap` both exist on purpose. rules_rust compiles with a
    // DWARF `DW_AT_comp_dir` value of ".", so each source path is relative to
    // the workspace root. The `cwd` value lets LLDB resolve those paths. The
    // `sourceMap` entry does the same if the debugger starts elsewhere.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug axum_app",
            "preLaunchTask": "Build axum_app (dbg)",
            "program": "${workspaceFolder}/bazel-bin/axum_app/axum_app",
            "args": [],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": [
                "rust"
            ],
            "sourceMap": {
                ".": "${workspaceFolder}"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug hello_world",
            "preLaunchTask": "Build hello_world (dbg)",
            "program": "${workspaceFolder}/bazel-bin/hello_world/hello_world",
            "args": [],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": [
                "rust"
            ],
            "sourceMap": {
                ".": "${workspaceFolder}"
            }
        }
    ]
}
